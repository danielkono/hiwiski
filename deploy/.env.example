# The configuration of the instance. Copy to `.env` and fill in.
#
# Every path is set; none has a silent default. If a required variable is missing, the
# server does not start -- with an English line that says which one. A server that comes
# up with half a configuration fails later at a place that has nothing to do with the
# cause.

# --- Version -------------------------------------------------------------------
# No `latest`. A version tag keeps the rollback open, and that is exactly what you need
# on the evening the update goes wrong.
HIWISKI_VERSION=2026.1.0

# --- Name on the home network --------------------------------------------------
# The name under which the family reaches the server. It is also part of the wall
# tablet's dashboard address.
HIWISKI_HOSTNAME=hiwiski.local

# --- Ports on the host -----------------------------------------------------------
# 80 and 443 where nothing else holds them. On a NAS whose admin interface already
# uses them, pick free ones (for example 8080 and 8443); the family then opens
# http://<name>:8080.
HIWISKI_HTTP_PORT=80
HIWISKI_HTTPS_PORT=443

# --- Database ------------------------------------------------------------------
# Both passwords are set once: Postgres takes them when its volume is created. Long
# random ones: openssl rand -hex 24
HIWISKI_DB_NAME=hiwiski
# The server's own role. It owns the database but is no superuser.
HIWISKI_DB_USER=hiwiski
HIWISKI_DB_PASSWORD=please-change
# Postgres's superuser. It creates the database and the server's role on the first
# start; the server never signs in with it.
HIWISKI_DB_ADMIN_USER=postgres
HIWISKI_DB_ADMIN_PASSWORD=please-change-too

# --- Time zone -----------------------------------------------------------------
# The family's home zone. Times are shown in the device's zone and entered in the
# calendar's zone.
HIWISKI_TIMEZONE=Europe/Berlin

# --- Backups -------------------------------------------------------------------
# The directory on this machine the backups go to -- created if it is missing. Better
# a USB disk or a NAS share mounted here than the disk the server runs on: a backup
# on the disk it protects is not a backup. The server sends nothing anywhere itself;
# let Hyper Backup, rsync or restic copy this directory on.
HIWISKI_BACKUP_DIR=./backups

# --- Media store -----------------------------------------------------------------
# What one member may store (0 = no limit) and how many uploads are processed at once.
# The defaults suit a family.
# HIWISKI_MEDIA_QUOTA_PER_MEMBER=5GB
# HIWISKI_MEDIA_PARALLEL_UPLOADS=4

# --- Network -----------------------------------------------------------------------
# The stack's own network is 10.217.84.0/24, and Caddy has 10.217.84.2 in it: the one
# address whose X-Forwarded-For the server believes. If Docker says the range overlaps
# another network (or your home network uses it), three other numbers:
# HIWISKI_NETWORK_PREFIX=10.217.84

# --- Setup code ------------------------------------------------------------------
# Until the setup wizard has run, whoever opens it first becomes the administrator. On
# a home network that is you, and the wizard asks for nothing. Is the server reachable
# from the internet? Then switch the setup code on: the wizard asks for the code the
# server prints to its log at every start until it is set up
# (`docker compose logs app | grep "Setup code"`).
# HIWISKI_SETUP_CODE_REQUIRED=true

# --- Rarely needed ---------------------------------------------------------------
# A fixed setup code instead of a new one at every start, for an automated install:
# something long and random, removed after. Set, the wizard asks for it even without
# HIWISKI_SETUP_CODE_REQUIRED.
# HIWISKI_SETUP_CODE=
# Whose X-Forwarded-For the server believes, as a regular expression over the proxy's
# address. Empty: Caddy's fixed address. Set,
# it replaces that address -- include Caddy's if it stays in front.
# SERVER_TOMCAT_REMOTEIP_INTERNALPROXIES=
