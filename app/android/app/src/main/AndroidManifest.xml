<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Reminders survive a reboot: the plugin reschedules them on BOOT_COMPLETED. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Cleartext on the home network is a supported mode; the app warns about it.
         Allowed for every host, not only private ones: a network security config matches
         domain names, not address ranges, and the home server is often reached by its IP
         (192.168.x.x) — Android frequently cannot resolve `.local`. Limiting cleartext to
         `.local` would block exactly that case. -->
    <!-- No Auto Backup: restored on a new phone, the keystore-encrypted token cannot be
         read (keystore keys are not backed up) next to a stale database and outbox —
         auth errors or a silent reset instead of a clean first run. The data lives on the
         family's server anyway. -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:label="Hiwiski"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- hiwiski://invite?host=…&code=… from the invitation QR.
                 An earlier version was missing exactly this registration. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="hiwiski" android:host="invite"/>
            </intent-filter>
        </activity>
        <!-- Reminders: flutter_local_notifications only declares its permissions
             itself; without these receivers scheduled notifications never show, and a
             reboot wipes them until the app is opened again. -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- The home screen widgets (docs/development/home-widgets.md): drawn with Glance,
             refreshed by WorkManager while the app is closed. Exported, as every widget
             receiver: the launcher sends their updates. -->
        <receiver
            android:name=".widgets.AgendaWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_agenda_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/home_widget_agenda" />
        </receiver>
        <receiver
            android:name=".widgets.ShoppingWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_shopping_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/home_widget_shopping" />
        </receiver>
        <receiver
            android:name=".widgets.TasksWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_tasks_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/home_widget_tasks" />
        </receiver>
        <receiver
            android:name=".widgets.KanbanWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_kanban_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/home_widget_kanban" />
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
